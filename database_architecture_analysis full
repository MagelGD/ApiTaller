        decimal subtotal
        decimal discount_percent
        decimal discount_amount
        decimal total
        decimal down_payment
        decimal balance "Total - DownPayment"
        string observations "Terminos de Garantia"
        string workshop_name
    }

    SALE_DETAIL {
        int id PK
        int sale_id FK
        int product_id FK "Opcional"
